{
  "title": "Eggplant & chickpea curry",
  "servings": "4",
  "trunk": "sauce",
  "ingredients": [
    { "id": "rice", "name": "rice", "qty": "1½ c" },
    { "id": "water", "name": "water", "qty": "2¼ c" },
    { "id": "rice-salt", "name": "salt", "qty": "½ tsp" },
    { "id": "eggplant", "name": "eggplant", "qty": "1 large" },
    { "id": "kosher-salt", "name": "kosher salt", "qty": "1 tsp" },
    { "id": "sear-oil", "name": "oil", "qty": "2 tbsp" },
    { "id": "onion", "name": "onion", "qty": "1" },
    { "id": "sweat-oil", "name": "oil", "qty": "2 tbsp" },
    { "id": "garlic", "name": "garlic", "qty": "4 cloves",
      "prep": { "verb": "mince", "done": "minced", "duration": { "min": 2, "basis": "estimated" } } },
    { "id": "ginger", "name": "ginger", "qty": "1 in",
      "prep": { "verb": "grate", "done": "grated", "duration": { "min": 2, "basis": "estimated" } } },
    { "id": "curry-powder", "name": "curry powder", "qty": "2 tbsp" },
    { "id": "cumin", "name": "cumin seed", "qty": "1 tsp" },
    { "id": "tomatoes", "name": "crushed tomatoes", "qty": "14 oz" },
    { "id": "chickpeas", "name": "chickpeas", "qty": "15 oz can",
      "prep": { "verb": "drain and rinse", "done": "drained", "duration": { "min": 1, "basis": "estimated" } } },
    { "id": "coconut-milk", "name": "coconut milk", "qty": "13.5 oz" },
    { "id": "lime", "name": "lime", "qty": "1",
      "prep": { "verb": "juice", "done": "juiced", "duration": { "min": 2, "basis": "estimated" } } },
    { "id": "cilantro", "name": "cilantro", "qty": "½ bunch",
      "prep": { "verb": "chop", "done": "chopped", "duration": { "min": 2, "basis": "estimated" } } }
  ],
  "components": [
    {
      "id": "rice",
      "name": "Rice",
      "outputName": "cooked rice",
      "stations": [
        { "id": "rinse-rice", "title": "Rinse rice", "attention": "active",
          "duration": { "min": 2, "basis": "estimated" },
          "adds": ["rice"], "merges": [],
          "cue": "until the water runs mostly clear",
          "detail": "Rinse the rice in a sieve until the water runs mostly clear." },
        { "id": "simmer-rice", "title": "Simmer, lid on", "attention": "passive",
          "duration": { "min": 18, "basis": "exact", "quote": "18 minutes — don't lift the lid" },
          "adds": ["water", "rice-salt"], "merges": [],
          "detail": "Bring the rice, water and salt to a boil, then cover, turn the heat to low and cook 18 minutes — don't lift the lid." },
        { "id": "rest-rice", "title": "Off heat, rest", "attention": "passive",
          "duration": { "min": 10, "basis": "stated", "quote": "10 minutes" },
          "adds": [], "merges": [],
          "detail": "Take the pot off the heat and let it sit, covered, for 10 minutes. Fluff with a fork." }
      ]
    },
    {
      "id": "eggplant",
      "name": "Eggplant",
      "outputName": "seared eggplant",
      "stations": [
        { "id": "dice-eggplant", "title": "Dice eggplant", "attention": "active",
          "duration": { "min": 4, "basis": "estimated" },
          "adds": ["eggplant"], "merges": [],
          "detail": "Cut the eggplant into 1-inch cubes." },
        { "id": "salt-eggplant", "title": "Salt, rest", "attention": "passive",
          "duration": { "min": 15, "basis": "stated", "quote": "15 minutes" },
          "adds": ["kosher-salt"], "merges": [],
          "cue": "until beads of moisture appear",
          "detail": "Toss with the kosher salt in a colander and let it sit 15 minutes." },
        { "id": "sear-eggplant", "title": "Pat dry, sear", "attention": "tending",
          "duration": { "min": 8, "basis": "stated", "quote": "about 8 minutes" },
          "adds": ["sear-oil"], "merges": [],
          "cue": "until deeply browned on most sides",
          "detail": "Pat the eggplant dry and sear in the oil over medium-high heat, turning occasionally, about 8 minutes." }
      ]
    },
    {
      "id": "sauce",
      "name": "Sauce",
      "stations": [
        { "id": "dice-onion", "title": "Dice onion", "attention": "active",
          "duration": { "min": 4, "basis": "estimated" },
          "adds": ["onion"], "merges": [],
          "detail": "Dice the onion." },
        { "id": "sweat", "title": "Sweat", "attention": "tending",
          "duration": { "min": 6, "max": 8, "basis": "stated", "quote": "6 to 8 minutes" },
          "adds": ["sweat-oil"], "merges": [],
          "cue": "until soft and translucent",
          "detail": "Cook the onion in the oil over medium heat, stirring now and then, 6 to 8 minutes until soft and translucent." },
        { "id": "aromatics", "title": "Add aromatics", "attention": "active",
          "duration": { "min": 1, "basis": "estimated" },
          "adds": ["garlic", "ginger"], "merges": [],
          "detail": "Add the garlic and ginger and stir." },
        { "id": "bloom", "title": "Bloom spices", "attention": "active",
          "duration": { "min": 1, "basis": "stated", "quote": "about 1 minute" },
          "adds": ["curry-powder", "cumin"], "merges": [],
          "cue": "until fragrant",
          "detail": "Stir in the curry powder and cumin seed and cook about 1 minute, until fragrant." },
        { "id": "cook-down", "title": "Cook down", "attention": "tending",
          "duration": { "min": 8, "max": 10, "basis": "stated", "quote": "8 to 10 minutes" },
          "adds": ["tomatoes"], "merges": [],
          "cue": "until darkened and jammy",
          "detail": "Add the tomatoes and cook, stirring occasionally, 8 to 10 minutes until darkened and jammy." },
        { "id": "combine", "title": "Combine", "attention": "active",
          "duration": { "min": 1, "basis": "estimated" },
          "adds": ["chickpeas", "coconut-milk"], "merges": ["eggplant"],
          "detail": "Stir in the eggplant, chickpeas and coconut milk." },
        { "id": "simmer-sauce", "title": "Simmer", "attention": "passive",
          "duration": { "min": 15, "basis": "stated", "quote": "15 minutes" },
          "adds": [], "merges": [],
          "cue": "until slightly thickened",
          "detail": "Simmer gently for 15 minutes, until slightly thickened." },
        { "id": "finish", "title": "Finish", "attention": "active",
          "duration": { "min": 1, "basis": "estimated" },
          "adds": ["lime", "cilantro"], "merges": [],
          "detail": "Stir in the lime juice and cilantro. Taste for salt." },
        { "id": "serve", "title": "Serve over rice", "attention": "active",
          "duration": { "min": 1, "basis": "estimated" },
          "adds": [], "merges": ["rice"],
          "detail": "Serve over the rice." }
      ]
    }
  ]
}
